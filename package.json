{
  "name": "developer-wiki",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.9.0",
  "engines": {
    "node": ">=22.11.0",
    "pnpm": ">=10.9.0 <11"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "typecheck:e2e": "tsc --noEmit -p tsconfig.e2e.json",
    "test:e2e": "playwright test",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yml,yaml}\""
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "~5.9.3"
  }
}
